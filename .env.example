# Copy to .env (git-ignored). Everything is optional; sources without keys are skipped.
DB_PATH=data/jobs.db
REQUEST_TIMEOUT=20
MAX_RETRIES=3
MAX_RESULTS_PER_SOURCE=50
LOG_LEVEL=INFO

# AI enrichment (Moonshot Kimi K2) - leave blank to use rule-based scoring only
KIMI_API_KEY=
KIMI_ENABLED=true
KIMI_MODEL=kimi-k2-0905-preview

# Extra sources
GITHUB_TOKEN=
SERPAPI_KEY=
X_BEARER_TOKEN=

# Dashboard cover letters
GEMINI_API_KEY=
